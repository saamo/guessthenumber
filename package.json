{
  "name": "guessthenumber",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless \"Guess the Number\" REST API on API Gateway, Lambda and DynamoDB",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage",
    "synth": "cdk synth",
